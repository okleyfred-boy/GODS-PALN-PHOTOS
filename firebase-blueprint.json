{
  "entities": {
    "Album": {
      "title": "Album",
      "description": "A collection of photos owned by a user.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Display name of the album." },
        "ownerId": { "type": "string", "description": "UID of the owner." },
        "createdAt": { "type": "number", "description": "Timestamp of creation." }
      },
      "required": ["title", "ownerId", "createdAt"]
    },
    "Photo": {
      "title": "Photo",
      "description": "An individual archived fragment.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the photo." },
        "description": { "type": "string", "description": "Detailed story." },
        "category": { "type": "string", "description": "Categorization." },
        "url": { "type": "string", "description": "Base64 data or URL." },
        "userId": { "type": "string", "description": "UID of the uploader." },
        "albumId": { "type": "string", "description": "ID of the parent album." },
        "createdAt": { "type": "number", "description": "Timestamp." }
      },
      "required": ["title", "description", "category", "url", "userId", "albumId", "createdAt"]
    }
  },
  "firestore": {
    "/albums/{albumId}": {
      "schema": "Album",
      "description": "User albums."
    },
    "/photos/{photoId}": {
      "schema": "Photo",
      "description": "Archived photos."
    }
  }
}
