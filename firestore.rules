rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Phase 3: Primitives & Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- COLLECTIONS ---

    // 1. ALBUMS
    match /albums/{albumId} {
      function isValidAlbum(data) {
        return data.title is string && data.title.size() <= 200
            && data.ownerId == request.auth.uid
            && (data.createdAt is number || data.createdAt is timestamp);
      }

      // Allow listing only if ownerId filter is present
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      // Allow specific document fetch if owner
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isValidAlbum(request.resource.data);

      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid
                   && isValidAlbum(request.resource.data)
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
                   && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 2. PHOTOS
    match /photos/{photoId} {
      function isValidPhoto(data) {
        return data.title is string && data.title.size() <= 200
            && data.url is string && data.url.size() <= 5000000 // Upped for reliability
            && data.userId == request.auth.uid
            && data.albumId is string
            && (data.createdAt is number || data.createdAt is timestamp);
      }

      function userOwnsAlbum(albumId) {
        return get(/databases/$(database)/documents/albums/$(albumId)).data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() 
                   && isValidPhoto(request.resource.data) 
                   && userOwnsAlbum(request.resource.data.albumId);

      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                   && isValidPhoto(request.resource.data)
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'category'])
                   && request.resource.data.userId == resource.data.userId
                   && request.resource.data.albumId == resource.data.albumId;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Default Deny (Pillar 0) - Moved to end
    match /{document=**} {
      allow read, write: if false;
    }

    // System Connection Check
    match /test/connection {
      allow read: if true;
    }
  }
}
