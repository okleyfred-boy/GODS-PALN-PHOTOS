rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Phase 3: Primitives & Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- COLLECTIONS ---

    // 1. ALBUMS
    match /albums/{albumId} {
      function isValidAlbum(data) {
        return data.title is string && data.title.size() <= 200
            && data.ownerId == request.auth.uid
            && (data.createdAt is number || data.createdAt is timestamp);
      }

      // Secure List Queries
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      
      allow get: if isSignedIn() && isValidId(albumId) && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn() 
                   && isValidAlbum(incoming())
                   && incoming().keys().hasAll(['title', 'ownerId', 'createdAt']);

      allow update: if isSignedIn() && isValidId(albumId) && existing().ownerId == request.auth.uid
                   && isValidAlbum(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['title'])
                   && incoming().ownerId == existing().ownerId;

      allow delete: if isSignedIn() && isValidId(albumId) && existing().ownerId == request.auth.uid;
    }

    // 2. PHOTOS
    match /photos/{photoId} {
      function isValidPhoto(data) {
        return data.title is string && data.title.size() <= 200
            && data.description is string && data.description.size() <= 5000
            && data.category is string && data.category.size() <= 100
            && data.url is string && data.url.size() <= 8000000
            && data.userId == request.auth.uid
            && data.albumId is string
            && (data.createdAt is number || data.createdAt is timestamp);
      }

      function userOwnsAlbum(albumId) {
        return exists(/databases/$(database)/documents/albums/$(albumId)) && 
               get(/databases/$(database)/documents/albums/$(albumId)).data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow get: if isSignedIn() && isValidId(photoId) && existing().userId == request.auth.uid;

      allow create: if isSignedIn() 
                   && isValidPhoto(incoming()) 
                   && userOwnsAlbum(incoming().albumId)
                   && incoming().keys().hasAll(['title', 'description', 'category', 'url', 'userId', 'albumId', 'createdAt']);

      allow update: if isSignedIn() && isValidId(photoId) && existing().userId == request.auth.uid
                   && isValidPhoto(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category'])
                   && incoming().userId == existing().userId
                   && incoming().albumId == existing().albumId;

      allow delete: if isSignedIn() && isValidId(photoId) && existing().userId == request.auth.uid;
    }

    // --- SYSTEM ---
    match /test/connection {
      allow read: if true;
    }

    // Fallback Deny (Pillar 0)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
